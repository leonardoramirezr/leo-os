# Where Neon is, copied from the project's Neon console. `scripts/build.mjs` and every app's
# `vite dev` read this file; in GitHub Actions the same two values come from the repository
# variables NEON_AUTH_URL and NEON_DATA_API_URL.
#
# Neither is a secret: both are the public addresses of services that decide for themselves what
# the caller may see, and both end up in the published JavaScript.
#
# Without them the site builds and runs, and every screen says there is no database.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1

# The schema the apps ask the Data API for. Empty is the published data, in `public`; the name of a
# preview's schema (`pnpm db:preview create <preview>` makes one) points `pnpm dev` at that copy.
VITE_NEON_DATA_API_SCHEMA=

# Where Leogram's links go: the Neon Function that gives each post a preview of its own in a chat
# (neon/leogram-link.ts), e.g. https://leogram.leo-os.is-cool.dev. Empty, a link leads straight to the
# app. In GitHub Actions it comes from the LEOGRAM_LINK_URL variable.
VITE_LEOGRAM_LINK_URL=

# The connection string, which `pnpm db:migrate` and `pnpm db:preview` need and nothing else does.
# This one IS a secret: it opens the whole database with none of the policies in the way. In GitHub
# Actions it comes from the DATABASE_URL secret.
DATABASE_URL=postgresql://neondb_owner:...@ep-xxx.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# What the two of them need besides, to tell the Data API which schemas to serve and to read the
# tables again after a migration: a Neon API key, which is a secret too, and the project's ID, from
# its settings in the console. In GitHub Actions they come from the NEON_API_KEY secret and the
# NEON_PROJECT_ID variable. Without them `pnpm db:migrate` still migrates, and says so.
NEON_API_KEY=napi_...
NEON_PROJECT_ID=...

# Leogram's bucket, in the project's Object Storage. `pnpm db:storage` makes it on the branch of the
# Data API above, if it is not there, and hands the database the key it signs the browser's
# addresses with. Its name, `leogram` when empty; in GitHub Actions, the LEOGRAM_BUCKET variable.
LEOGRAM_BUCKET=

# A key of your own to sign with: a credential with storage:read and storage:write, from the Neon
# console or `neon credentials create`. Without one, `pnpm db:storage` makes one of its own,
# `leo-os-leogram`. In GitHub Actions they come from the secrets of the same names.
LEOGRAM_STORAGE_ACCESS_KEY_ID=
LEOGRAM_STORAGE_SECRET_ACCESS_KEY=
